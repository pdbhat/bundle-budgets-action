{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "directory": "dist",
  "budgets": [
    {
      "pathPattern": "**/*.js",
      "maxRawSize": "1.5MB",
      "maxGzipSize": "350KB",
      "maxBrotliSize": "300KB"
    },
    {
      "pathPattern": "**/*.css",
      "maxGzipSize": "50KB"
    }
  ]
}
